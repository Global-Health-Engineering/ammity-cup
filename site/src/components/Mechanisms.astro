---
import { readCsv } from '../lib/csv.js';
import site from '../data/site.json';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const scores = Object.fromEntries(readCsv('data/ground-test-scores.csv').map((r) => [r.variant, r]));
const cards = [
  { slug: 'flower-low', name: 'Flower Low', status: 'Flown', flown: true, note: 'Highest score; minor leakage only under extreme handling. The only design flown.' },
  { slug: 'flower-high', name: 'Flower High', status: 'Bench-tested', note: 'Same score, largest volume held; slight friction on insertion.' },
  { slug: 'duckbill', name: 'Duckbill', status: 'Bench-tested', note: 'Opens when squeezed; judged unlikely to stay sealed in microgravity, so not taken further.' },
  { slug: 'twister', name: 'Twister', status: 'Bench-tested', note: 'Top and bottom pull apart on extraction and the membrane untwists.' },
  { slug: 'drawstring', name: 'Drawstring', status: 'Bench-tested', note: 'The lid sits too high to close the opening.' },
  { slug: 'umbrella', name: 'Umbrella', status: 'Bench-tested', note: 'Thin umbrella structures failed within the first few activations.' },
  { slug: 'balloon', name: 'Balloon', status: 'Not reliably manufacturable', note: 'Thin membranes could not be cast reliably; not scored.' },
  { slug: 'extraction-valve', name: 'Extraction valve', status: 'Untested concept', note: 'A cup with a valve button for emptying in place; designed, not tested.' },
];
const photos = [
  { file: 'flower-low', w: 1108, h: 1108, alt: 'The Flower Low prototype cast in silicone: a purple cup with orange petals inside the rim.', caption: 'Flower Low: petals (orange) inside the rim.' },
  { file: 'flower-high', w: 1101, h: 1102, alt: 'The Flower High prototype cast in silicone: a purple cup with orange petals sitting close to the rim.', caption: 'Flower High: the petals sit nearer the rim.' },
  { file: 'duckbill', w: 1200, h: 1200, alt: 'Looking into the opening of the Duckbill prototype: a purple cup with a narrow duckbill-shaped slit at its centre.', caption: 'Duckbill, seen into the opening.' },
  { file: 'twister', w: 1018, h: 1018, alt: 'The Twister prototype cast in silicone: an orange inner skin visible inside the purple cup.', caption: 'Twister: the orange inner skin inside the cup.' },
  { file: 'drawstring', w: 1100, h: 1101, alt: 'The Drawstring prototype held with its lid open: orange test fluid leaking out past the lid.', caption: 'Drawstring: test fluid leaking past the lid, the failure behind its sealing score of 1.' },
  { file: 'umbrella', w: 1056, h: 1055, alt: 'The Umbrella prototype cast in silicone: an orange umbrella structure on a green frame inside the opening.', caption: 'Umbrella: the orange umbrella and its green frame inside the opening.' },
];
---
<section id="mechanisms">
  <div class="eyebrow">Mechanisms</div>
  <h2>Closing mechanisms</h2>
  <p class="lead">
    Every mechanism closes the same base cup. Six were cast and scored on the
    bench out of {site.bench.score_max}; the scores and the scale are under
    <a href="#validation">Validation</a>. Parts that come from separate CAD
    files are shown side by side, not assembled. The eighth card, the
    extraction valve, is a later concept: designed, but not tested and not
    part of the thesis.
  </p>
  <div class="render-grid">
    {cards.map((c) => (
      <figure class="render">
        <button type="button" class="render-open" data-model={`${base}/models/concept-${c.slug}.glb`} data-caption={c.name}>
          <img src={`${base}/renders/concept-${c.slug}.png`} alt={`Render of the ${c.name} SpaceCup concept.`} loading="lazy" />
          <span class="render-cue" aria-hidden="true">View in 3D</span>
          <span class="visually-hidden">Open an interactive 3D model of the {c.name}</span>
        </button>
        <figcaption>
          <strong>{c.name}</strong>{' '}
          <span class:list={['status', { flown: c.flown }]}>{c.status}</span>
          {scores[c.slug] && <span class="score">{scores[c.slug].overall}/{site.bench.score_max}</span>}
          <br />{c.note}{' '}
          <a href={`${site.repo}/tree/main/hardware/${c.slug}`}>Files</a>
        </figcaption>
      </figure>
    ))}
  </div>
  <h3>The prototypes</h3>
  <div class="photo-grid">
    {photos.map((p) => (
      <figure class="photo">
        <img src={`${base}/photos/${p.file}.webp`} alt={p.alt} width={p.w} height={p.h} loading="lazy" />
        <figcaption>{p.caption}</figcaption>
      </figure>
    ))}
  </div>
</section>
<style>
  .score { font-family: var(--mono); font-weight: 600; color: var(--fg); margin-left: 6px; }
  strong { color: var(--fg); }
  #mechanisms h3 { margin: 32px 0 0; }
</style>
