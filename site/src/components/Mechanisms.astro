---
import { readCsv } from '../lib/csv.js';
import site from '../data/site.json';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const scores = Object.fromEntries(readCsv('data/ground-test-scores.csv').map((r) => [r.variant, r]));
// Render-specific captions mirror tools/parts.py's CONCEPT_CAPTIONS in
// meaning: each derived or simplified render (Balloon, Drawstring, Flower
// High) is labelled here the same way it is labelled there, so the site
// and the render script never disagree about what a render shows.
const cards = [
  { slug: 'flower-low', name: 'Flower Low', status: 'Flown', flown: true,
    note: 'Highest score; minor leakage only under extreme handling. The only design flown.',
    caption: 'Flower Low: five petals at the opening, each joined by a silicone string (purple) to the pull mechanism in the stem; the strings are shown straight, as cast.',
    alt: 'Render of the Flower Low SpaceCup concept: a grey cup with five purple petals and strings at the opening.' },
  { slug: 'flower-high', name: 'Flower High', status: 'Bench-tested',
    note: 'Same score, largest volume held; slight friction on insertion. Petals and strings coloured by position, since the CAD is one solid.',
    caption: 'Flower High: the same petal-and-string mechanism, petals and strings shown in purple, with the petal bases nearer the rim.',
    alt: 'Render of the Flower High SpaceCup concept: a grey cup with purple petals and strings near the rim.' },
  { slug: 'duckbill', name: 'Duckbill', status: 'Bench-tested', note: 'Opens when squeezed; judged unlikely to stay sealed in microgravity, so not taken further.',
    caption: 'Duckbill: moulded as two halves and joined, shown as the mirrored pair; the duckbill valve is purple.',
    alt: 'Render of the Duckbill SpaceCup concept: a grey cup body shown as its mirrored halves, with the purple duckbill valve at the centre.' },
  { slug: 'twister', name: 'Twister', status: 'Bench-tested', note: 'Top and bottom pull apart on extraction and the membrane untwists.',
    caption: 'Twister: the grey top and bottom cup sections, with the purple membrane skin that joins them shown beside them.',
    alt: 'Render of the Twister SpaceCup concept: grey top and bottom cup sections beside the purple twist membrane.' },
  { slug: 'drawstring', name: 'Drawstring', status: 'Bench-tested',
    note: 'The lid sits too high to close the opening. The purple lid is shown flat, as moulded, beside the cup; in the cup it is folded against the inner wall.',
    caption: 'Drawstring: the grey cup body beside its purple lid. The purple lid is shown flat, as moulded, beside the cup; in the cup it is folded against the inner wall.',
    alt: 'Render of the Drawstring SpaceCup concept: a grey cup seen from above beside a flat purple lid with its string.' },
  { slug: 'umbrella', name: 'Umbrella', status: 'Bench-tested', note: 'Thin umbrella structures failed within the first few activations.',
    caption: 'Umbrella: the grey cup body beside the purple umbrella insert and its silicone housing.',
    alt: 'Render of the Umbrella SpaceCup concept: a grey cup body beside the purple umbrella insert and its housing.' },
  { slug: 'balloon', name: 'Balloon', status: 'Not reliably manufacturable',
    note: 'Thin membranes could not be cast reliably; not scored. The purple balloon is the cavity of its mould; no part file for it exists.',
    caption: 'Balloon: the grey cup body and bulb pipe, beside the purple balloon. The purple balloon is the cavity of its mould; no part file for it exists.',
    alt: 'Render of the Balloon SpaceCup concept: a grey cup with a bulb pipe, and a purple flattened balloon beside it, derived from the mould cavity.' },
  { slug: 'extraction-valve', name: 'Extraction valve', status: 'Untested concept', note: 'A cup with a valve button for emptying in place; designed, not tested.',
    caption: 'Extraction valve: the grey cup body beside the purple valve button. Untested concept.',
    alt: 'Render of the Extraction valve SpaceCup concept: a grey cup body beside the purple valve button.' },
];
const photos = {
  'flower-low': { w: 1108, h: 1108, alt: 'The Flower Low prototype cast in silicone: a purple cup with orange petals inside the rim.', caption: 'Flower Low: petals (orange) inside the rim.' },
  'flower-high': { w: 1101, h: 1102, alt: 'The Flower High prototype cast in silicone: a purple cup with orange petals sitting close to the rim.', caption: 'Flower High: the petals sit nearer the rim.' },
  duckbill: { w: 1200, h: 1200, alt: 'Looking into the opening of the Duckbill prototype: a round dark opening crossed by a thin orange line.', caption: 'Duckbill, seen into the opening.' },
  twister: { w: 1018, h: 1018, alt: 'The Twister prototype cast in silicone: an orange inner skin visible inside the purple cup.', caption: 'Twister: the orange inner skin inside the cup.' },
  drawstring: { w: 1100, h: 1101, alt: 'The Drawstring prototype held upside down, its purple lid across the opening: orange test fluid leaking out around the lid\u2019s edge.', caption: 'Drawstring: test fluid leaking past the lid, the failure behind its sealing score of 1.' },
  umbrella: { w: 1056, h: 1055, alt: 'The Umbrella prototype cast in silicone: an orange umbrella structure on a green frame inside the opening.', caption: 'Umbrella: the orange umbrella and its green frame inside the opening.' },
};
// The two mechanisms without a prototype photo say why, so the empty cell is
// never read as a missing file.
const noPhoto = {
  balloon: 'No prototype photo: the thin membranes could not be cast reliably.',
  'extraction-valve': 'No prototype photo: designed, not tested.',
};
---
<section id="mechanisms">
  <h2>Closing mechanisms</h2>
  <p class="lead">
    Six closing mechanisms were designed, cast from silicon, and scored on the
    bench out of {site.bench.score_max}. Every mechanism closes the same base
    cup. The scores and the scale are under <a href="#validation">Validation</a>.
    Parts that come from separate CAD files are shown side by side, not assembled.
    The eighth card, the extraction valve, is a later concept: designed, but not
    tested and not part of the thesis.

    The prototypes were cast in coloured silicone; in the renders, colour
    marks the role of a part (grey body, purple closing mechanism), not its
    material.
  </p>
  <div class="mech-list">
    {cards.map((c) => (
      <div class="mech">
        <div class="mech-pair">
          <figure class="mech-cell">
            <button type="button" class="render-open" data-model={`${base}/models/concept-${c.slug}.glb`} data-caption={c.caption}>
              <img src={`${base}/renders/concept-${c.slug}.png`} alt={c.alt} loading="lazy" />
              <span class="render-cue" aria-hidden="true">View in 3D</span>
              <span class="visually-hidden">Open an interactive 3D model of the {c.name}</span>
            </button>
          </figure>
          {photos[c.slug] ? (
            <figure class="mech-cell">
              <button type="button" class="photo-open" data-full={`${base}/photos/${c.slug}.webp`} data-caption={photos[c.slug].caption}>
                <img src={`${base}/photos/${c.slug}.webp`} alt={photos[c.slug].alt} width={photos[c.slug].w} height={photos[c.slug].h} loading="lazy" />
                <span class="photo-cue" aria-hidden="true">View larger</span>
                <span class="visually-hidden">Open a larger view of this photo</span>
              </button>
            </figure>
          ) : (
            <p class="mech-nophoto">{noPhoto[c.slug]}</p>
          )}
        </div>
        <p class="mech-meta">
          <strong>{c.name}</strong>{' '}
          <span class:list={['status', { flown: c.flown }]}>{c.status}</span>
          {scores[c.slug] && <a class="score" href="#bench-scores">Bench score: {scores[c.slug].overall}/{site.bench.score_max}</a>}
          <br />{c.note}{' '}
          <a href={`${site.repo}/tree/main/hardware/${c.slug}`}>Files</a>
        </p>
      </div>
    ))}
  </div>
</section>
<style>
  .score { font-family: var(--sans); font-weight: 600; color: var(--accent); text-decoration: none; margin-left: 6px; }
  .score:hover, .score:focus-visible { text-decoration: underline; }
  strong { color: var(--fg); }
  .mech-list { display: grid; gap: 24px; margin-top: 32px; }
  .mech {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px;
  }
  .mech-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; align-items: start; }
  .mech-cell { margin: 0; min-width: 0; }
  .mech-cell img { display: block; width: 100%; height: auto; border-radius: 4px; }
  .mech-nophoto {
    margin: 0;
    align-self: center;
    font-size: 13px;
    color: var(--fg-dim);
    padding: 0 8px;
  }
  .mech-meta { margin: 14px 0 0; font-size: 14.5px; color: var(--fg-dim); line-height: 1.5; }
  /* One column on phones, so neither the render nor the photo is squeezed. */
  @media (max-width: 700px) {
    .mech-pair { grid-template-columns: 1fr; }
  }
</style>
