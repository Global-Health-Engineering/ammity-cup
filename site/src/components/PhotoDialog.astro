<!--
  A native <dialog>, shaped like ModelDialog: showModal() gives the focus
  trap, the Esc-to-close binding, the inert background and the ::backdrop
  for free.
-->
<dialog id="photo-dialog" aria-label="Photo">
  <div class="photo-head">
    <p class="photo-caption" id="photo-caption"></p>
    <div class="photo-actions">
      <button type="button" id="photo-close" class="photo-btn" aria-label="Close photo">Close</button>
    </div>
  </div>
  <div class="photo-stage" id="photo-stage">
    <img id="photo-img" src="" alt="" />
  </div>
</dialog>

<script>
  // Progressive enhancement: every photo is a plain <img> inside a
  // <button>, so with this script dead the photo is still visible on the
  // page, only the larger-view affordance is missing. Hence the early
  // return rather than any fallback path.
  const dialog = document.getElementById('photo-dialog') as HTMLDialogElement | null;
  const img = document.getElementById('photo-img') as HTMLImageElement | null;
  const caption = document.getElementById('photo-caption');
  const openers = document.querySelectorAll<HTMLButtonElement>('.photo-open');

  if (dialog && img && caption && openers.length && dialog.showModal) {
    let opener: HTMLButtonElement | null = null;

    function open(button: HTMLButtonElement) {
      opener = button;
      caption!.textContent = button.dataset.caption ?? '';
      img!.src = button.dataset.full ?? '';
      img!.alt = button.dataset.caption ?? '';
      dialog!.showModal();
    }

    function close() {
      dialog!.close();
    }

    openers.forEach((button) => button.addEventListener('click', () => open(button)));
    document.getElementById('photo-close')?.addEventListener('click', close);

    // Covers Esc, which fires `close` on the dialog without going through
    // the button above.
    dialog.addEventListener('close', () => {
      opener?.focus();
    });

    // Clicking the backdrop closes. Same two-part check as ModelDialog: a
    // gesture only counts as a backdrop click if it both starts and ends
    // outside the dialog's own box, so a drag that starts on the photo
    // (for example, a text selection or a touch scroll gesture) and ends
    // past the edge does not close the dialog.
    let pressedOutside = false;
    const isOutside = (event: { clientX: number; clientY: number }) => {
      const box = dialog!.getBoundingClientRect();
      return (
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom
      );
    };
    dialog.addEventListener('pointerdown', (event) => {
      pressedOutside = isOutside(event);
    });
    dialog.addEventListener('click', (event) => {
      if (pressedOutside && isOutside(event)) close();
      pressedOutside = false;
    });
  }
</script>

<style is:global>
  #photo-dialog {
    width: min(92vw, 900px);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
  }
  #photo-dialog::backdrop {
    background: rgba(16, 19, 23, .55);
  }
  .photo-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }
  .photo-caption {
    margin: 0;
    font-size: 13.5px;
    color: var(--fg-dim);
  }
  .photo-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  .photo-btn {
    border: 1px solid var(--line);
    background: var(--bg-2);
    color: var(--fg);
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 13px;
    cursor: pointer;
  }
  .photo-btn:hover { border-color: var(--accent); color: var(--accent); }

  /* The photo is shown fitted, at the largest size that fits the stage,
     never larger than its own natural size: no click-to-enlarge toggle,
     no panning, no overflow scrolling. Height is viewport-relative and
     capped, same reasoning as .model-stage, so the caption and Close
     button stay on screen on a short laptop window; on a phone the
     dialog already fills almost the whole screen (92vw wide, up to 70vh
     of stage), and the browser's own pinch gesture, untouched by
     anything here, is what is left to get closer. */
  .photo-stage {
    position: relative;
    height: min(70vh, 640px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-2);
  }
  #photo-img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
</style>
