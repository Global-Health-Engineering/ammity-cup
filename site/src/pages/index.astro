---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import Hero from '../components/Hero.astro';
import Why from '../components/Why.astro';
import Device from '../components/Device.astro';
import Mechanisms from '../components/Mechanisms.astro';
import Make from '../components/Make.astro';
import Use from '../components/Use.astro';
import Validation from '../components/Validation.astro';
import Limits from '../components/Limits.astro';
import ModelDialog from '../components/ModelDialog.astro';
import PhotoDialog from '../components/PhotoDialog.astro';
import Footer from '../components/Footer.astro';
---
<Base title={`${site.name}, an open-source menstrual cup for reduced gravity`} description={site.tagline}>
  <Hero />
  <Why />
  <Mechanisms />
  <Device />
  <Make />
  <Use />
  <Validation />
  <Limits />
  <ModelDialog />
  <PhotoDialog />
  <Footer />
</Base>
