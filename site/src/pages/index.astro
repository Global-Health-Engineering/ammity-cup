---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import Hero from '../components/Hero.astro';
import Why from '../components/Why.astro';
import Footer from '../components/Footer.astro';
// Task 13 inserts, in order after Why: Device, Mechanisms, Make, Use,
// Validation, Limits, then ModelDialog before Footer.
---
<Base title={`${site.name}, an open-source menstrual cup for reduced gravity`} description={site.tagline}>
  <Hero />
  <Why />
  <Footer />
</Base>
